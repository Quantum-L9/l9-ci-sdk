{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.quantum-l9.dev/l9-ci-sdk/v1/semgrep-consumer-rulepack-evidence.schema.json",
  "title": "SemgrepConsumerRulepackEvidence",
  "description": "The record of one consumer rulepack execution (`l9-ci semgrep consumer-run`, ADR 0021), written beside the raw report as <stem>.consumer.json before Semgrep starts. It names the owner, the declaration and every rule file by SHA-256, so a domain rule is never mistaken for a central one. It carries no verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "owner",
    "declaration",
    "rule_id_prefix",
    "canonical_rule_id_prefix",
    "rule_files",
    "rules",
    "nosem",
    "consumer_semgrepignore",
    "analysis_budget"
  ],
  "properties": {
    "schema": { "const": "l9.semgrep-consumer-rulepack-evidence/v1" },
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9._-]{1,100}$"
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": ".l9/semgrep-consumer-rules.yaml" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "rule_id_prefix": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*\\.$" },
    "canonical_rule_id_prefix": { "type": "string", "pattern": "^CONSUMER-[A-Z0-9-]+-$" },
    "rule_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "rule_ids"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "rule_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "canonical_rule_id", "include", "exclude"],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "canonical_rule_id": { "type": "string", "pattern": "^CONSUMER-[A-Z0-9-]+$" },
          "include": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "nosem": {
      "description": "Consumer-owned rules keep the consumer's inline nosemgrep (ADR 0021 decision 4).",
      "const": "honored"
    },
    "consumer_semgrepignore": { "const": "honored" },
    "analysis_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "timeout_threshold", "on_timeout"],
      "properties": {
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "timeout_threshold": { "type": "integer", "minimum": 0 },
        "on_timeout": { "const": "incomplete" }
      }
    }
  }
}
