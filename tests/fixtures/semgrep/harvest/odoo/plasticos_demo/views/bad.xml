<?xml version="1.0" encoding="utf-8"?>
<!-- Known-bad Odoo 19 XML written for the harvest evidence. One line per rule. -->
<odoo>
  <record id="view_demo_tree" model="ir.ui.view">
    <field name="arch" type="xml">
      <tree decoration-secondary="state == 'draft'">
        <field name="name" attrs="{'invisible': [('state', '=', 'done')]}"/>
      </tree>
    </field>
  </record>
  <record id="action_demo" model="ir.actions.act_window">
    <field name="view_mode">tree,form</field>
  </record>
  <record id="action_demo_attr" model="ir.actions.act_window" view_mode="tree,form"/>
  <template id="demo_report"><span t-esc="doc.name"/></template>
  <record id="cron_demo" model="ir.cron">
    <field name="model_id" ref="model_plasticos_demo"/>
    <field name="numbercall" numbercall="-1">-1</field>
  </record>
  <record id="group_demo" model="res.groups">
    <field name="category_id" ref="base.module_category_hidden"/>
  </record>
  <record id="view_demo_search" model="ir.ui.view">
    <field name="arch" type="xml">
      <search string="Demo">
        <group name="group_by" string="Group By"/>
      </search>
    </field>
  </record>
  <record id="rule_demo" model="ir.rule">
    <field name="groups" eval="[(4, ref("base.group_user"))]"/>
  </record>
</odoo>
