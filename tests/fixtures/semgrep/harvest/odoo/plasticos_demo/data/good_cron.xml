<?xml version="1.0" encoding="utf-8"?>
<!-- Known-good Odoo 19 XML written for the harvest evidence: the accepted form of each case in bad.xml. -->
<odoo>
  <record id="view_demo_list" model="ir.ui.view">
    <field name="arch" type="xml">
      <list decoration-muted="state == 'draft'">
        <field name="name" invisible="state == 'done'"/>
      </list>
    </field>
  </record>
  <record id="action_demo" model="ir.actions.act_window">
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_demo_attr" model="ir.actions.act_window" view_mode="list,form"/>
  <template id="demo_report"><span t-out="doc.name"/></template>
  <record id="cron_demo" model="ir.cron">
    <field name="model_id" ref="plasticos_demo.model_plasticos_demo"/>
    <field name="interval_number">1</field>
  </record>
  <record id="group_demo" model="res.groups">
    <field name="privilege_id" ref="base.privilege_demo"/>
  </record>
  <record id="view_demo_search" model="ir.ui.view">
    <field name="arch" type="xml">
      <search>
        <group name="group_by"/>
      </search>
    </field>
  </record>
  <record id="rule_demo" model="ir.rule">
    <field name="groups" eval="[(4, ref('base.group_user'))]"/>
  </record>
</odoo>
